<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Osservatorio Relazioni Familiari – Effetto “Due Cani” nei Nonni</title>
  <meta name="description" content="Articoli divulgativi sull'ipotesi che la presenza di almeno due cani in casa dei nonni favorisca socialità e serenità nei bambini." />
  <style>
    :root{
      --bg:#0b1220;
      --card:#121b2e;
      --muted:#a9b3c9;
      --text:#eef2ff;
      --accent:#7dd3fc;
      --accent2:#a7f3d0;
      --border:rgba(255,255,255,.08);
      --shadow: 0 12px 40px rgba(0,0,0,.35);
      --radius: 18px;
      --max: 1100px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, "Noto Sans", "Helvetica Neue", sans-serif;
      background: radial-gradient(1200px 700px at 10% 0%, rgba(125,211,252,.18), transparent 55%),
                  radial-gradient(1000px 600px at 90% 10%, rgba(167,243,208,.14), transparent 60%),
                  linear-gradient(180deg, #070b14, var(--bg));
      color: var(--text);
      line-height: 1.55;
    }
    a{color:inherit}
    .container{max-width:var(--max); margin:0 auto; padding: 26px 18px 60px}
    header{
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(10px);
      background: linear-gradient(180deg, rgba(11,18,32,.9), rgba(11,18,32,.6));
      border-bottom: 1px solid var(--border);
    }
    .topbar{
      max-width: var(--max);
      margin: 0 auto;
      padding: 14px 18px;
      display:flex; align-items:center; justify-content:space-between; gap: 12px;
    }
    .brand{
      display:flex; align-items:center; gap: 10px; min-width: 240px;
      text-decoration:none;
    }
    .logo{
      width: 38px; height: 38px; border-radius: 12px;
      background: linear-gradient(135deg, rgba(125,211,252,.95), rgba(167,243,208,.85));
      box-shadow: 0 8px 20px rgba(125,211,252,.18);
      display:grid; place-items:center;
      color:#0b1220; font-weight:800;
      letter-spacing: -0.5px;
    }
    .brand span{display:block}
    .brand .title{font-weight:750; letter-spacing:-.2px}
    .brand .tag{font-size: 12px; color: var(--muted); margin-top: -2px}
    nav{
      display:flex; align-items:center; gap: 14px; flex-wrap:wrap;
    }
    nav a{
      text-decoration:none;
      color: var(--muted);
      font-size: 14px;
      padding: 8px 10px;
      border-radius: 10px;
      transition: .15s ease;
    }
    nav a:hover{color: var(--text); background: rgba(255,255,255,.06)}
    .btn{
      border:1px solid var(--border);
      background: rgba(255,255,255,.06);
      color: var(--text);
      padding: 9px 12px;
      border-radius: 12px;
      cursor:pointer;
      transition:.15s ease;
      font-size: 14px;
    }
    .btn:hover{transform: translateY(-1px); background: rgba(255,255,255,.09)}
    .hero{
      padding: 28px 0 8px;
      display:grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 18px;
      align-items: stretch;
    }
    @media (max-width: 880px){
      .hero{grid-template-columns:1fr; padding-top:18px}
      .brand{min-width:auto}
    }
    .card{
      background: rgba(18,27,46,.75);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .hero .lead{
      padding: 22px 22px 18px;
      position:relative;
    }
    .kicker{
      display:inline-flex; gap:8px; align-items:center;
      font-size: 12px; color: var(--muted);
      border: 1px solid var(--border);
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(255,255,255,.04);
    }
    .dot{
      width: 8px; height: 8px; border-radius: 99px;
      background: var(--accent);
      box-shadow: 0 0 0 4px rgba(125,211,252,.12);
    }
    h1{
      margin: 14px 0 10px;
      font-size: clamp(28px, 3.2vw, 44px);
      line-height: 1.05;
      letter-spacing: -0.8px;
    }
    .subtitle{
      color: var(--muted);
      font-size: 16px;
      margin: 0 0 14px;
    }
    .meta{
      display:flex; flex-wrap:wrap; gap:10px;
      color: var(--muted);
      font-size: 13px;
      align-items:center;
    }
    .pill{
      border: 1px solid var(--border);
      background: rgba(255,255,255,.04);
      padding: 6px 10px;
      border-radius: 999px;
    }
    .side{
      display:grid;
      grid-template-rows: auto 1fr;
      gap: 12px;
      padding: 18px;
    }
    .side h3{margin: 4px 0 8px; font-size: 16px}
    .stat{
      display:grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .stat .item{
      padding: 12px 12px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: rgba(255,255,255,.04);
    }
    .stat .num{
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.2px;
    }
    .stat .lbl{color: var(--muted); font-size: 12px}
    .grid{
      margin-top: 18px;
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 880px){ .grid{grid-template-columns:1fr} }
    article{
      padding: 18px 18px 16px;
    }
    article h2{
      margin: 0 0 8px;
      letter-spacing: -.35px;
      font-size: 20px;
      line-height: 1.2;
    }
    .byline{
      display:flex; flex-wrap:wrap; gap:10px;
      color: var(--muted);
      font-size: 13px;
      margin: 0 0 10px;
    }
    .byline .tag{
      border: 1px solid var(--border);
      padding: 4px 8px;
      border-radius: 999px;
      background: rgba(255,255,255,.04);
    }
    .abstract{
      color: var(--text);
      opacity: .95;
      margin: 0 0 10px;
    }
    .keypoints{
      margin: 12px 0 0;
      padding: 0;
      list-style:none;
      display:grid;
      gap: 8px;
    }
    .keypoints li{
      padding: 10px 10px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,.04);
      color: var(--muted);
    }
    .keypoints b{color: var(--text)}
    .refs{
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px dashed rgba(255,255,255,.14);
      color: var(--muted);
      font-size: 12.5px;
    }
    .refs ol{margin: 8px 0 0 18px; padding: 0}
    .refs li{margin: 6px 0}
    .note{
      margin-top: 16px;
      padding: 14px;
      border-radius: 16px;
      border: 1px solid rgba(125,211,252,.22);
      background: rgba(125,211,252,.08);
      color: rgba(238,242,255,.92);
      font-size: 14px;
    }
    .controls{
      margin-top: 16px;
      display:flex; gap: 10px; flex-wrap:wrap;
      align-items:center; justify-content:space-between;
    }
